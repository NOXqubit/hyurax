# Nó semente da rede de TESTE do Hyurax. Instalado por deploy/instalar-semente.sh.
[Unit]
Description=Hyurax - no semente da testnet
After=network-online.target
Wants=network-online.target

[Service]
User=hyurax
Group=hyurax
ExecStart=/usr/local/bin/hyurax-no no --rede testnet --pasta /var/lib/hyurax/testnet --porta 8790 --exportar /var/lib/hyurax/publico/estado.json
Restart=always
RestartSec=5
# Endurecimento: o nó só precisa da própria pasta e da rede.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/hyurax
MemoryMax=512M

[Install]
WantedBy=multi-user.target
